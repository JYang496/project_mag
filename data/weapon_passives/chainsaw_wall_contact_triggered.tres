[gd_resource type="Resource" script_class="WeaponPassiveBranchDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/WeaponPassiveBranchDefinition.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
passive_id = "chainsaw_wall_contact_triggered"
display_name = "Wall Contact"
description = "Close debuff trigger. Chainsaw projectiles bounce within their spawn cell; the first boundary contact arms hits to slow and apply vulnerability. Each bounce adds 1 second of lifetime, up to 2 seconds total. Reloading resets and refreshes the state."
condition_type = "event_reaction"
refresh_type = "reload"
ui_mode = "state"
