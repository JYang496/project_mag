; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Protocol: Mag Arena"
run/main_scene="uid://dwxulua8fpqd0"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

LoadingPerformance="*res://autoload/LoadingPerformance.gd"
GlobalVariables="*res://autoload/GlobalVariables.gd"
PlayerData="*res://autoload/PlayerData.gd"
DataHandler="*res://autoload/DataHandler.gd"
LocalizationManager="*res://autoload/LocalizationManager.gd"
PhaseManager="*res://autoload/PhaseManager.gd"
SpawnData="*res://autoload/SpawnData.gd"
EnemyRegistry="*res://autoload/EnemyRegistry.gd"
CollectableRegistry="*res://autoload/CollectableRegistry.gd"
InventoryData="*res://autoload/InventoryData.gd"
TaskRewardManager="*res://autoload/TaskRewardManager.gd"
RewardDraftRuntime="*res://autoload/RewardDraftRuntime.gd"
CellEffectRuntime="*res://autoload/CellEffectRuntime.gd"
CellTaskModuleRuntime="*res://autoload/CellTaskModuleRuntime.gd"
DisplaySettings="*res://autoload/DisplaySettings.gd"
AudioSettings="*res://autoload/AudioSettings.gd"
PlayerAssistSettings="*res://autoload/PlayerAssistSettings.gd"
ObjectPool="*res://autoload/ObjectPool.gd"
EnemySimulationSystem="*res://autoload/EnemySimulationSystem.gd"
ProjectileSimulationSystem="*res://autoload/ProjectileSimulationSystem.gd"
CombatRuntimeMetrics="*res://autoload/CombatRuntimeMetrics.gd"
TimeImpactController="*res://autoload/TimeImpactController.gd"
RunPacingTelemetry="*res://autoload/RunPacingTelemetry.gd"
DamageManager="*res://autoload/DamageManager.gd"
CursorManager="*res://autoload/CursorManager.gd"
BattleContractManager="*res://autoload/BattleContractManager.gd"
SaveManager="*res://autoload/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/size/min_width=1280
window/size/min_height=720

[file_customization]

folder_colors={
"res://Npc/": "yellow",
"res://Objects/": "gray",
"res://Player/": "green",
"res://UI/": "orange",
"res://Utility/": "teal",
"res://asset/": "purple",
"res://autoload/": "gray"
}

[global_group]

collectables="collectables"
enemies=""
npc=""
player=""

[gui]

theme/custom_font="res://asset/fonts/fusion_pixel/fusion-pixel-12px-proportional-zh_hans.ttf"

