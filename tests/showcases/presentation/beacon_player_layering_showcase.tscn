[gd_scene format=3 uid="uid://b5vhf332uhpng"]

[sub_resource type="GDScript" id="GDScript_rtft2"]
script/source = "extends Node

const HYBRID_VIEW := preload(\"res://Visual/Oblique/hybrid_ground_view_3d.gd\")
const CELL_SCENE := preload(\"res://Board/Cells/cell.tscn\")
const PLAYER_SCENE := preload(\"res://Player/Mechas/scenes/Player.tscn\")
const BEACON_SCENE := preload(\"res://World/battle_contract/tactical_beacon.tscn\")

const TEST_POSITIONS := [
	{\"label\": \"INSIDE\", \"position\": Vector2(48.0, 0.0)},
	{\"label\": \"ON RIGHT PROGRESS EDGE\", \"position\": Vector2(70.0, 0.0)},
	{\"label\": \"OUTSIDE\", \"position\": Vector2(96.0, 0.0)},
]

class ShowcaseBoard:
	extends Node2D
	var cells: Array = []

	func get_cells() -> Array:
		return cells

var _player: Node2D
var _label: Label


func _ready() -> void:
	var board := ShowcaseBoard.new()
	board.name = \"Board\"
	add_child(board)
	var cell := CELL_SCENE.instantiate() as Cell
	cell.position = Vector2(-256.0, -256.0)
	board.add_child(cell)
	board.cells.append(cell)

	_player = PLAYER_SCENE.instantiate() as Node2D
	_player.process_mode = Node.PROCESS_MODE_DISABLED
	add_child(_player)
	PlayerData.player = _player

	var beacon := BEACON_SCENE.instantiate() as Area2D
	beacon.position = Vector2.ZERO
	add_child(beacon)
	beacon.call(\"set_progress\", 0.78)
	beacon.call(\"_on_body_entered\", _player)

	var view := HYBRID_VIEW.new()
	view.name = \"HybridGroundView3D\"
	view.board_path = NodePath(\"../Board\")
	add_child(view)
	_create_overlay()
	call_deferred(\"_capture_states\")


func _capture_states() -> void:
	for index in range(TEST_POSITIONS.size()):
		var state := TEST_POSITIONS[index] as Dictionary
		_player.position = state.position as Vector2
		_label.text = \"%d/3 %s — protocol remains complete, player remains foreground\" % [index + 1, str(state.label)]
		await get_tree().create_timer(0.9).timeout
		await RenderingServer.frame_post_draw
		var path := OS.get_temp_dir().path_join(\"magarena-beacon-player-layer-%d.png\" % (index + 1))
		var error := get_viewport().get_texture().get_image().save_png(path)
		print(\"BEACON_LAYER_CAPTURE state=%d path=%s error=%d\" % [index + 1, path, error])
	print(\"BEACON_LAYER_READY\")


func _create_overlay() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 100
	add_child(layer)
	var panel := ColorRect.new()
	panel.position = Vector2(18.0, 16.0)
	panel.size = Vector2(720.0, 46.0)
	panel.color = Color(0.01, 0.025, 0.04, 0.88)
	layer.add_child(panel)
	_label = Label.new()
	_label.position = Vector2(14.0, 9.0)
	_label.add_theme_font_size_override(\"font_size\", 18)
	panel.add_child(_label)


func _exit_tree() -> void:
	if PlayerData.player == _player:
		PlayerData.player = null
"

[node name="BeaconPlayerLayeringShowcase" type="Node" unique_id=1746455227]
script = SubResource("GDScript_rtft2")
